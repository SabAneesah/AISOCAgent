# Optional SQLite location (defaults to ./data/sentinel.db)
# SENTINEL_DB_PATH=./data/sentinel.db

# Comma-separated process names for DET-003
SENTINEL_PROCESS_WATCHLIST=mimikatz.exe,procdump.exe,psexec.exe

# AI investigations use local evidence-based analysis by default.
# External LLM provider support can be configured in a future adapter.
SENTINEL_LLM_PROVIDER=disabled
